{
  "name": "exam-engine",
  "version": "2.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:validator": "python3 -m unittest tests/validator_test.py",
    "validate:sample": "python3 .agents/skills/mcq-pack-generator/scripts/validate_pack.py mcq-exam-website/sample-mcq-pack.json",
    "verify": "npm test && npm run test:validator && npm run validate:sample",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}
